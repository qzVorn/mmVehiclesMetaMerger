{
  "name": "mmVehiclesMetaMerger",
  "version": "2.1.0",
  "description": "Tool made to easily merge multiple GTA5 vehicle meta files, with a desktop interface.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "cli": "node app.js",
    "build:win": "electron-builder --win --x64",
    "build:cli": "pkg app.js --targets node16-win-x64 --output dist-cli/mmVehiclesMetaMerger-cli.exe",
    "test": "node test/verify.js"
  },
  "author": "mmleczek <mmleczek.com>",
  "license": "ISC",
  "dependencies": {
    "cli-table": "^0.3.11",
    "colors": "^1.0.3",
    "glob": "^7.2.0",
    "prettytable": "^0.3.1",
    "readline": "^1.3.0",
    "xml2js": "^0.5.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "pkg": "^5.5.2"
  },
  "build": {
    "appId": "com.mmleczek.mmvehiclesmetamerger",
    "productName": "mmVehiclesMetaMerger",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "mmVehiclesMetaMerger-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "mmVehiclesMetaMerger-${version}-setup.exe",
      "shortcutName": "mmVehiclesMetaMerger"
    }
  }
}
